{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run alembic current)",
      "Bash(uv run alembic history *)",
      "Bash(uv run alembic check)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm gen:api)",
      "Bash(pnpm build)",
      "Bash(python3 docs/catalog/validate_catalog.py *)",
      "Bash(python docs/catalog/validate_catalog.py *)",
      "Bash(pre-commit run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(docker compose -f deploy/docker-compose.dev.yml ps *)",
      "Bash(docker compose -f deploy/docker-compose.dev.yml logs *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(pnpm add *)",
      "Bash(uv run alembic upgrade *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.prod*)",
      "Read(./**/.env.dev)",
      "Bash(cat *.env*)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(ssh *)",
      "Edit(./frontend/src/api/schema.d.ts)",
      "Edit(./frontend/src/api/openapi.json)"
    ]
  }
}
