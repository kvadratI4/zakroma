# Caddy of the prod stack (T-007, docs/09-deployment.md §2). SITE_ADDRESS: the domain (Let's Encrypt)
# or 127.0.0.1 for a local run (Caddy's internal CA). Checked by backend/tests/smoke.
{
	admin off
	# The local CA stays inside the container: no attempt to add it to a system trust store.
	skip_install_trust
	# Clients send no SNI for an IP address (local run at https://127.0.0.1:8443).
	default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
	# No access log here: paths may carry invite and reset tokens. The api logs every request
	# with the route template instead of the path (rules/backend.md).
	encode zstd gzip

	# One id for the request in Caddy and api logs; a value sent by the client is replaced.
	request_header X-Request-ID {http.request.uuid}

	handle /api/* {
		# API bodies are small JSON. A declared size of 1 000 000 bytes or more is refused at once;
		# max_size also cuts a chunked or understated body when the api reads it.
		request_body {
			max_size 1MB
		}
		@too_large header_regexp Content-Length ^[0-9]{7,}$
		handle @too_large {
			header Content-Type application/problem+json
			respond `{"type":"https://zakroma/errors/payload-too-large","title":"Слишком большой запрос","status":413,"code":"payload_too_large"}` 413
		}
		handle {
			reverse_proxy api:8000
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# The camera is switched on for the barcode scanner in S2 (camera=(self)).
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# No inline scripts or styles: theme tokens are a constructed stylesheet (src/main.tsx).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	# Hashed file names: cached for a year. Everything else (index.html) is revalidated, so a new
	# release reaches the family at once.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/* /api/*
	header @other Cache-Control "no-cache"
}
