# Variables of the prod stack (deploy/docker-compose.yml). Do not fill this file: create the real
# git-ignored deploy/.env with random passwords by
#   python3 backend/scripts/init_prod_env.py --site-address <domain | 127.0.0.1>
# docs/09-deployment.md §3.
#
# Postgres superuser, used only when the data volume is initialised.
POSTGRES_PASSWORD=
# zakroma_owner: owns the database and schema, runs migrations (service migrate).
ZAKROMA_OWNER_PASSWORD=
# zakroma_app: the api role, data only (SELECT/INSERT/UPDATE/DELETE).
ZAKROMA_APP_PASSWORD=
# Domain for Let's Encrypt in prod; 127.0.0.1 for a local run with Caddy's internal CA.
SITE_ADDRESS=
# Local run only (127.0.0.1): loopback ports instead of 80/443.
HTTP_BIND=
HTTPS_BIND=
